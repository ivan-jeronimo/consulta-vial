#!/bin/sh
# docker compose de producción con las variables de ambos .env. Ej.: ./dc ps, ./dc logs -f app
# Sin metadatos de procedencia: con ellos cada build cambia de id aunque el contenido sea igual.
export BUILDX_NO_DEFAULT_ATTESTATIONS=1
cd "$(dirname "$0")" && exec docker compose --env-file .env --env-file backend/.env -f docker-compose.prod.yml "$@"
