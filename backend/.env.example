APP_NAME="Consulta Vial"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Mexico_City

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=consulta_vial
DB_USERNAME=consulta_vial
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=3700

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Panel de administración (MVP: token estático, migrar a Sanctum) ---
ADMIN_API_TOKEN=

# --- RAG / Embeddings ---
# Proveedores: openai | gemini | fake (vectores deterministas, sin red, solo desarrollo)
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
# Debe coincidir con la columna vector(N); cambiarlo exige migrar y re-procesar.
EMBEDDINGS_DIMENSIONS=1536
EMBEDDINGS_BATCH_SIZE=96
# Nivel gratuito de Gemini: 100 textos/min (se deja margen para las consultas). 0 = sin tope (nivel de pago).
EMBEDDINGS_TEXTS_PER_MINUTE=80
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- LLM que redacta la respuesta del bot ---
# anthropic | openai (reusa OPENAI_API_KEY) | gemini (reusa GEMINI_API_KEY) | none (solo artículos)
# openai y gemini requieren LLM_MODEL
LLM_PROVIDER=anthropic
# Vacío = claude-sonnet-5-5 con anthropic
LLM_MODEL=
# Razonamiento de modelos Gemini 3: low (rápido, recomendado) | high | vacío = por defecto
LLM_THINKING=low
ANTHROPIC_API_KEY=

# Clientes de la API de fuentes (solo lectura), un token por cliente separado por coma.
# El sitio Andantes del Asfalto usa uno (en su .env: CONSULTA_VIAL_TOKEN).
FUENTES_API_TOKENS=
